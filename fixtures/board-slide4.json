  "steps": [
    {
      "n": 1,
      "summary": "axes: membrane potential (−90, 0, +20 mV) vs time 0–400 ms",
      "narrationAnchor": "The vertical axis is membrane potential"
    },
    {
      "n": 2,
      "summary": "phase 4 flat at −90 mV to 20 ms",
      "narrationAnchor": "A ventricular cell at rest sits at about minus ninety"
    },
    {
      "n": 3,
      "summary": "phase 0 upstroke −90 → +20 mV at 20 ms",
      "narrationAnchor": "Fast sodium channels open, sodium rushes in"
    },
    {
      "n": 4,
      "summary": "phase 1 notch to ~+3 mV",
      "narrationAnchor": "Phase 1 is this small notch"
    },
    {
      "n": 5,
      "summary": "phase 2 plateau ~0 mV 25–220 ms; Ca2+ in / K+ out arrows, balance",
      "narrationAnchor": "Phase 2, the plateau. For about two hundred milliseconds"
    },
    {
      "n": 6,
      "summary": "phase 3 repolarisation 220–300 ms to −90 mV; phase 4 to 400 ms",
      "narrationAnchor": "Phase 3: the calcium channels close, potassium wins"
    },
    {
      "n": 7,
      "summary": "tension curve in accent: rise 40 ms, peak 190 ms, baseline by 335 ms",
      "narrationAnchor": "Now, in a second colour, the tension curve"
    },
    {
      "n": 8,
      "summary": "ARP bar 20–250 ms, hatched RRP bar 250–300 ms",
      "narrationAnchor": "Under the axis I shade the absolute refractory period"
    },
    {
      "n": 9,
      "summary": "skeletal panel: 2 ms AP, 100 ms twitch, 30 ms stimulus train → summation → tetanus",
      "narrationAnchor": "Now skeletal muscle, on the right"
    },
    {
      "n": 10,
      "summary": "caption: cardiac ARP ≈ contraction → no tetanus",
      "narrationAnchor": "In the heart, by the time the cell"
    }
  ],
